rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /meetings/{mid} {
      // Anyone signed in who has the link can open a meeting.
      allow get: if request.auth != null;
      // The meeting list only shows meetings you created or replied to.
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // The creator can edit; anyone else may only add themselves to members.
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
         request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [request.auth.uid].toSet())
      );
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // One availability doc per person; only that person can write it.
      match /avail/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
